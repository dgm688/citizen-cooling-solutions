# --- Lead delivery (quote form) -------------------------------------------
# Email via Resend. Both are required for email delivery.
RESEND_API_KEY=
LEAD_FROM_EMAIL="Citizen Cooling Website <quotes@citizencoolingsolutions.co.ke>"
# Where quote requests are sent. Defaults to company.email in src/lib/site.ts.
LEAD_TO_EMAIL=
# Optional: also POST every lead as JSON (CRM, Zapier, Google Sheet).
LEAD_WEBHOOK_URL=

# --- Spam protection (optional, recommended) -------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics -------------------------------------------------------------
# GA4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# --- Search Console --------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
